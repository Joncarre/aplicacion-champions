# ─────────────────────────────────────────────────────────────
# Modo demo: "true" usa localStorage en vez de Firestore.
# Permite desarrollar y probar la app entera sin credenciales.
# En produccion debe ir a "false".
# ─────────────────────────────────────────────────────────────
VITE_DEMO_MODE=true

# Fecha simulada, solo en modo demo, para probar la app a mitad de competicion.
# Formato YYYY-MM-DD o YYYY-MM-DDTHH:mm, en hora de Madrid. Vacio = fecha real.
VITE_DEMO_NOW=

# ─────────────────────────────────────────────────────────────
# Credenciales de Firebase (Consola > Configuracion del proyecto
# > Tus apps > App web > Configuracion del SDK)
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nickname que recibe permisos de administrador al registrarse.
VITE_ADMIN_NICKNAME=joncarre
